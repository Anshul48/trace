+def test_forensic_pass_never_changes_strict_verdict(tmp_path: Path, mini_capsule):
+    mp, manifest, _ = mini_capsule
+    out = tmp_path / "summary.json"
+    proc = run([sys.executable, str(VERIFIER), "--manifest", str(mp),
